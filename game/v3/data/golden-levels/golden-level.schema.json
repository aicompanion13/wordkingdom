{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "word-kingdom-authored-golden-level-v1",
  "title": "Word Kingdom Authored Golden Level",
  "type": "object",
  "required": ["schemaVersion", "levelId", "version", "themeKey", "seed", "initialGrid", "objectives", "activationRules", "zoneContract", "states", "expectedCompletionStateId", "replayMetadata", "auditMetadata"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "levelId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "themeKey": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "initialGrid": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "pattern": "^[A-Z]$" } }
    },
    "objectives": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "word", "path", "direction", "primaryZone", "chain", "chainIndex", "tutorialCues"]
      }
    },
    "activationRules": {
      "type": "object",
      "required": ["kind", "initialStateId", "initialActiveObjectives", "queuedObjectives", "maximumActiveObjectives"],
      "properties": { "kind": { "const": "AUTHORED_STATE_GRAPH" }, "maximumActiveObjectives": { "const": 2 } }
    },
    "zoneContract": {
      "type": "object",
      "required": ["rowBands", "columnBands", "centreTieBreak"],
      "properties": { "centreTieBreak": { "const": "LOWER_NUMBERED_BAND" } }
    },
    "states": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "completedObjectives", "activeObjectives", "queuedObjectives", "expectedBoardHash", "branches", "expectedCompletion"]
      }
    },
    "expectedCompletionStateId": { "type": "string" },
    "replayMetadata": { "type": "object" },
    "auditMetadata": { "type": "object" }
  }
}
